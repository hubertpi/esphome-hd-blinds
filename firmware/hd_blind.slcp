# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: hd_blind
label: HD Blind BGM13P22
description: |
  Experimental REV.J blind motor controller with Home Assistant BLE control,
  independent direction speeds, encoder diagnostics, and physical pairing.
category: Bluetooth Examples
filter:
- name: Device Type
  value: [SoC]
- name: Project Difficulty
  value: [Beginner]
- name: Wireless Technology
  value: [Bluetooth]
package: Bluetooth
quality: production
readme:
- {path: readme.md}
source:
- {path: main.c}
- {path: app.c}
- {path: src/board.c}
- {path: src/ota.c}
- {path: src/battery.c}
tag: ['hardware:rf:band:2400']
include:
- path: ''
  file_list:
  - {path: app.h}
- path: src
  file_list:
  - {path: board.h}
  - {path: ota.h}
  - {path: battery.h}
  - {path: battery_curve.h}
  - {path: motion.h}
sdk: {id: gecko_sdk, version: 4.4.6}
toolchain_settings: []
config_file:
- override:
    component: gatt_configuration
    file_id: gatt_configuration_file_id
  path: config/btconf/gatt_configuration.btconf
  directory: btconf
component:
- {id: bluetooth_feature_gatt_server}
- {id: in_place_ota_dfu}
- {id: bluetooth_feature_sm}
- {id: bluetooth_feature_legacy_advertiser}
- {id: mpu}
- {id: gatt_configuration}
- {id: gatt_service_device_information}
- {id: bluetooth_stack}
- {id: bluetooth_feature_gatt}
- {id: nvm3_default}
- {id: mbedtls_hmac}
- {id: mbedtls_sha256}
- {id: bt_post_build}
- {id: bluetooth_feature_connection}
- {id: bluetooth_feature_system}
- {id: component_catalog}
- {id: BGM13P22F512GA}
- {id: bootloader_interface}
- {id: app_assert}
- {id: emlib_adc}
configuration:
- {name: SL_STACK_SIZE, value: '2752'}
- {name: SL_HEAP_SIZE, value: '9200'}
- condition: [psa_crypto]
  name: SL_PSA_KEY_USER_SLOT_COUNT
  value: '0'
ui_hints:
  highlight:
  - {path: readme.md, focus: true}
  - {path: config/btconf/gatt_configuration.btconf}

